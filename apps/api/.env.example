# Server
PORT=4000

# Postgres connection string (local dev: local Postgres install; prod: Neon)
# Replace YOUR_PASSWORD with your local postgres password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tradekwik

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS: comma-separated allowed origins (storefront + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Storage (local disk in dev; R2/S3 adapter later)
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads

# Public base URL of this API (used to build uploaded-image URLs)
API_PUBLIC_URL=http://localhost:4000
