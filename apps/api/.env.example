# Server
PORT=4000

# Postgres connection string (local dev: local Postgres install; prod: Neon)
# Replace YOUR_PASSWORD with your local postgres password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tradekwik

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS: comma-separated allowed origins (storefront + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Where new-seller registration alerts are emailed
ADMIN_NOTIFY_EMAIL=tradekwik.team@gmail.com

# OTP (mobile verification at sign-up)
#   console  – dev: code is logged and returned in the API response (never in production)
#   msg91    – MSG91 OTP API: needs MSG91_AUTH_KEY + DLT-approved MSG91_TEMPLATE_ID
#   2factor  – 2Factor.in OTP API: needs TWOFACTOR_API_KEY (TWOFACTOR_TEMPLATE optional, default OTP1)
OTP_PROVIDER=console
# Abuse limits (defaults shown)
OTP_MAX_SENDS_PER_DAY=2        # codes per mobile number per rolling 24 hours
OTP_MAX_ATTEMPTS=3             # wrong guesses before the code is burned
OTP_RESEND_AFTER_SEC=60        # minimum gap between two codes to the same number
OTP_CODE_TTL_MIN=10            # minutes a code stays valid
OTP_MAX_SENDS_PER_IP_DAY=10    # codes one IP/device may trigger per day (any numbers)
OTP_TOKEN_TTL_MIN=15           # minutes to finish sign-up after verifying
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWOFACTOR_API_KEY=
# TWOFACTOR_TEMPLATE=OTP1

# Behind nginx / a cloud load balancer set TRUST_PROXY=1 so the real client IP is used
# (admin IP allow-list, OTP per-IP limits). Leave unset when the API is reached directly.
# TRUST_PROXY=1

# Storage (local disk in dev; R2/S3 adapter later)
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads

# Public base URL of this API (used to build uploaded-image URLs)
API_PUBLIC_URL=http://localhost:4000
