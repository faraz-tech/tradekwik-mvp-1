# Server
PORT=4000

# Postgres connection string (local dev: docker container on 5433; prod: Neon)
# Dev container: docker run -d --name tradekwik-postgres --restart unless-stopped -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=tradekwik -p 5433:5432 -v tradekwik-pgdata:/var/lib/postgresql/data postgres:17-alpine
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/tradekwik

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS: comma-separated allowed origins (storefront + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Storage (local disk in dev; R2/S3 adapter later)
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
