# ============================================================================
# TradeKwik seller + platform admin app — PRODUCTION environment
# Copy to the server as  apps/admin/.env.production
#
# NEXT_PUBLIC_* values are baked in at BUILD time — fill this in before building.
# ============================================================================

# The admin app is client-heavy: the browser calls the API directly.
NEXT_PUBLIC_API_URL=https://api.tradekwik.com/api/v1         # <<CHANGE>>

# WhatsApp number that receives "Activate my plan" messages from the seller
# Billing page. Digits only, with country code, no + or spaces.
NEXT_PUBLIC_SUPPORT_WHATSAPP=<<CHANGE — e.g. 919876500000>>
