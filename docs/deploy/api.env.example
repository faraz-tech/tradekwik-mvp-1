# ============================================================================
# TradeKwik API — PRODUCTION environment
# Copy to the server as  apps/api/.env  (never commit the filled-in file).
# Every value marked  <<CHANGE>>  must be replaced before you go live.
# ============================================================================

NODE_ENV=production
PORT=4000

# ---------------------------------------------------------------------------
# Database — managed Postgres (Neon, Supabase, RDS…). Must include sslmode.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/tradekwik?sslmode=require   # <<CHANGE>>

# ---------------------------------------------------------------------------
# Auth — JWT signing key. Generate with:  openssl rand -base64 48
# Changing it logs everyone out. Never reuse the dev value.
# ---------------------------------------------------------------------------
JWT_SECRET=<<CHANGE — 48+ random bytes>>
JWT_EXPIRES_IN=7d

# Share the login cookie across your subdomains (note the leading dot).
# Required so tradekwik.com and seller.tradekwik.com both see the session.
COOKIE_DOMAIN=.tradekwik.com                                            # <<CHANGE>>

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Exact origins allowed to call the API with credentials. No trailing slash.
CORS_ORIGINS=https://tradekwik.com,https://www.tradekwik.com,https://seller.tradekwik.com  # <<CHANGE>>

# Public URL of this API. Used to build uploaded-file URLs, so it must be the
# address browsers can reach (not localhost).
API_PUBLIC_URL=https://api.tradekwik.com                                # <<CHANGE>>

# REQUIRED when the API sits behind nginx / a cloud load balancer, otherwise
# every request appears to come from the proxy and the admin IP allow-list
# plus the OTP per-IP limits break.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# API reference. Leave unset to keep /api/docs closed in production.
# ---------------------------------------------------------------------------
# ENABLE_SWAGGER=1

# ---------------------------------------------------------------------------
# Uploads — product images, bilty photos, compliance documents.
# 'local' writes to UPLOADS_DIR, which MUST be a persistent disk. A container
# filesystem is wiped on every deploy and you will lose every uploaded document.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOADS_DIR=/var/lib/tradekwik/uploads                                  # <<CHANGE>>

# ---------------------------------------------------------------------------
# OTP for mobile verification at sign-up.
#   console  – code is logged AND returned in the response. DEV ONLY.
#   2factor  – 2Factor.in, no DLT registration needed, fastest to start.
#   msg91    – MSG91, needs a DLT-approved template.
# ---------------------------------------------------------------------------
OTP_PROVIDER=2factor                                                    # <<CHANGE>>
TWOFACTOR_API_KEY=<<CHANGE>>
# TWOFACTOR_TEMPLATE=OTP1
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Abuse limits (defaults shown; raise only if genuine users complain)
OTP_MAX_SENDS_PER_DAY=2
OTP_MAX_ATTEMPTS=3
OTP_RESEND_AFTER_SEC=60
OTP_CODE_TTL_MIN=10
OTP_MAX_SENDS_PER_IP_DAY=10
OTP_TOKEN_TTL_MIN=15

# ---------------------------------------------------------------------------
# Notifications. Email currently uses a logging transport and WhatsApp is a
# stub — see docs/DEPLOYMENT.md §9 before relying on either.
# ---------------------------------------------------------------------------
ADMIN_NOTIFY_EMAIL=tradekwik.team@gmail.com
