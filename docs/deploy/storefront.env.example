# ============================================================================
# TradeKwik storefront (public site) — PRODUCTION environment
# Copy to the server as  apps/storefront/.env.production
#
# IMPORTANT: every NEXT_PUBLIC_* value is baked into the JavaScript bundle at
# BUILD time. This file must exist, filled in, BEFORE you run `pnpm build`.
# Changing one of them later requires a rebuild, not just a restart.
# ============================================================================

# Server-side fetches (Next server → API). Can be an internal address.
API_URL=https://api.tradekwik.com/api/v1                     # <<CHANGE>>

# Browser-side fetches (inquiry/order forms, buyer account). Must be public.
NEXT_PUBLIC_API_URL=https://api.tradekwik.com/api/v1         # <<CHANGE>>

# Canonical URLs, sitemap, Open Graph and share links. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tradekwik.com                   # <<CHANGE>>

# Seller app — used by "Sell on TradeKwik" and "Register your business".
NEXT_PUBLIC_ADMIN_URL=https://seller.tradekwik.com           # <<CHANGE>>

# Shown on About / Contact / Terms / Privacy / Refund pages.
NEXT_PUBLIC_CONTACT_EMAIL=tradekwik.team@gmail.com
NEXT_PUBLIC_LEGAL_ENTITY=<<CHANGE — your registered business name>>
NEXT_PUBLIC_LEGAL_ADDRESS=<<CHANGE — city, state (used for jurisdiction)>>

# Seller pricing page is hidden while pricing is being finalised.
# Set to 1 to publish /pricing.
NEXT_PUBLIC_SHOW_PRICING=0
